# Twitch credentials
TWITCH_OAUTH_TOKEN=oauth:your_token_here
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
TWITCH_BOT_ID=your_bot_user_id_here
TWITCH_NICK=your_bot_name
TWITCH_PREFIX=!
TWITCH_CHANNELS=yourchannel1,yourchannel2

# RAG / llama.cpp
# Point these to local GGUF files
LLAMA_CPP_MODEL_PATH=/absolute/path/to/your/chat-model.gguf
LLAMA_CPP_EMBED_MODEL_PATH=/absolute/path/to/your/embedding-model.gguf
# Optional performance tuning
LLAMA_CPP_N_CTX=4096
LLAMA_CPP_N_GPU_LAYERS=0
# LLAMA_CPP_N_THREADS=8
